generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String     @id @default(uuid())
  nama      String     @unique 
  userRoles UserRole[]
  createdBy String?
  updatedBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  isDeleted Boolean    @default(false)
}

model User {
  id            String          @id @default(uuid())
  nama          String
  email         String          @unique
  password      String
  userRoles     UserRole[]
  usulanBuku    UsulanBuku[]
  sumbanganBuku SumbanganBuku[]
  logPembaca    LogPembaca[]    
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  isDeleted     Boolean         @default(false)
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isDeleted Boolean  @default(false)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Kategori {
  id        String   @id @default(uuid())
  nama      String   @unique
  buku      Buku[]
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isDeleted Boolean  @default(false)
}

model JenisLiteratur {
  id        String   @id @default(uuid())
  nama      String   @unique
  buku      Buku[]
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isDeleted Boolean  @default(false)
}

model Buku {
  id               String          @id @default(uuid())
  judul            String
  penulis          String
  penerbit         String?
  tahunTerbit      Int?
  filePdf          String?         
  isGratis         Boolean         @default(true)
  isActive         Boolean         @default(true) 
  kategoriId       String?
  kategori         Kategori?       @relation(fields: [kategoriId], references: [id])
  jenisLiteraturId String?
  jenisLiteratur   JenisLiteratur? @relation(fields: [jenisLiteraturId], references: [id])
  logPembaca       LogPembaca[]
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  isDeleted        Boolean         @default(false)
}

model UsulanBuku {
  id        String   @id @default(uuid())
  judul     String
  penulis   String
  alasan    String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  isDeleted Boolean  @default(false)
}

model SumbanganBuku {
  id          String   @id @default(uuid())
  judulBuku   String
  penulis     String
  kondisi     String
  tahunTerbit Int?     
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  isDeleted   Boolean  @default(false)
}

model LogPembaca {
  id          String   @id @default(uuid())
  bukuId      String
  userId      String?  
  buku        Buku     @relation(fields: [bukuId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
  diaksesPada DateTime @default(now()) 
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  isDeleted   Boolean  @default(false)
}